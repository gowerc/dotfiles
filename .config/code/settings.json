	///////////////////
	//
	//  Python
	//
	///////////////////
    "python.analysis.typeCheckingMode": "standard",
    "python.languageServer": "Pylance",
    "python.analysis.completeFunctionParens": true,

    
    
    
    ///////////////////
	//
	//  CPP
	//
	///////////////////
    
    "[cpp]": {
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.insertMode": "replace",
        "editor.semanticHighlighting.enabled": true,
        "editor.formatOnType" : false,
    },
    
    
    
    
	///////////////////
	//
	//  VIM
	//
	///////////////////

    "vim.handleKeys":{
        "<C-c>": false,
        "<C-x>": false,
        "<C-v>": false,
        "<C-z>": false,
        "<C-b>": false,
        "<C-a>": false,
        "<C-s>": false,
        "<C-f>": false,
        "<C-r>": false,
        "<C-k>": false,
        "<C-d>": false,
        "<C-p>": false,
        "<C-i>": false,
        "<C-w>": false,
    },
    "keyboard.dispatch": "keyCode",
    


    ///////////////////
	//
	//  TODO-Tree
	//
	///////////////////
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        "[x]"
    ],
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
    
    
    ///////////////////////////////////
    //
    //  Git
    //
    ///////////////////////////////////
    
    
    "git.ignoreLegacyWarning": true,
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "never",
    "git.autofetch": true,
    
    "githubPullRequests.pullBranch": "never",            // Disable automatic pulling of branches
    "githubPullRequests.createOnPublishBranch": "never", // Disable automatic creation of MRs
    
    
    ///////////////////////////////////
    //
    //  emmet
    //
    ///////////////////////////////////
    
    "emmet.excludeLanguages": [],  // Default exclude includes markdown
    "emmet.triggerExpansionOnTab": true,
    "emmet.includeLanguages": {
        "quarto": "html",
        "markdown": "html"
    },
    
    
    ///////////////////////////////////
    //
    //  SAS
    //
    ///////////////////////////////////

    
    
    ///////////////////////////////////
    //
    //  Unsorted
    //
    //////////////////////////////////
    
    "spellright.language": [
        "English (British)"
    ],
    
    "liveServer.settings.donotVerifyTags": true,
    "liveServer.settings.donotShowInfoMsg": true,
    

    "security.workspace.trust.untrustedFiles": "open",
    "liveSassCompile.settings.showOutputWindowOn": "Debug",
    
    
    "path-intellisense.mappings": {
        "./": "${workspaceFolder}",
        // "lib": "${workspaceFolder}/lib",
        // "global": "/Users/dummy/globalLibs"
    },
    "hexeditor.columnWidth": 16,
    "hexeditor.showDecodedText": true,
    "hexeditor.defaultEndianness": "little",
    "hexeditor.inspectorType": "aside",
    "debug.onTaskErrors": "abort",
    "debug.focusEditorOnBreak": false,
    "workbench.startupEditor": "none",
    "python.terminal.activateEnvironment": false,
    "github.copilot.enable": {
        "quarto": false,
        "*": false,
        "cpp": false,
        "python": false,
        "R": false
    },
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    
    "hediet.vscode-drawio.resizeImages": null,
    "cmake.pinnedCommands": [
        "workbench.action.tasks.configureTaskRunner",
        "workbench.action.tasks.runTask"
    ],
    "lldb.suppressUpdateNotifications": true,
    "SAS.connectionProfiles": {
        "activeProfile": "",
        "profiles": {}
    },
    "docker.lsp.telemetry": "off",
    "gitlens.telemetry.enabled": false,
    "telemetry.editStats.enabled": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "window.zoomLevel": 1.7,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "chat.viewSessions.enabled": false,
    "terminal.integrated.suggest.enabled": false,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    "dev.containers.dockerPath": "podman",
    "dev.containers.dockerComposePath": "podman-compose",
    "diffEditor.renderSideBySideInlineBreakpoint": 1400,
    
    
    
    
    "[r]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "Posit.air-vscode"
    },
    "editor.inlayHints.enabled": "offUnlessPressed",
    "git.blame.editorDecoration.enabled": false,
    "git.blame.statusBarItem.enabled": false,

}